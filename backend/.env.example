# Copy to backend/.env. Existing process environment variables take precedence.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# Local emails are printed in the Django terminal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_FROM_EMAIL=noreply@localhost
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_TLS=false

MARKETPLACE_REQUIRE_VERIFIED_EMAIL=true
MARKETPLACE_MODERATE_LISTINGS=true
MARKETPLACE_REQUIRE_PAYMENT_TO_ACTIVATE=false
MARKETPLACE_REQUIRE_PAYMENT_TO_COMPLETE=true

# With DEBUG=false, HTTPS redirect and secure cookies default to true.
# Set a unique secret and real allowed hosts before using that mode.
